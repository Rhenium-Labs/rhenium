{
	"name": "rhenium",
	"description": "Monorepo for Rhenium, an AI powered discord bot.",
	"homepage": "https://github.com/Rhenium-Labs/rhenium#readme",
	"bugs": {
		"url": "https://github.com/Rhenium-Labs/rhenium/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rhenium-Labs/rhenium.git"
	},
	"contributors": [
		"Eddy <cobaltorum>",
		"SpiderMat <SplderMat>"
	],
	"packageManager": "bun@1.3.10",
	"workspaces": [
		"packages/*",
		"dashboard"
	],
	"scripts": {
		"fmt": "turbo run format && cargo fmt --manifest-path backend/Cargo.toml",
		"check": "turbo run typecheck && cargo check --manifest-path backend/Cargo.toml",
		"lint": "cargo clippy --manifest-path backend/Cargo.toml -- -D warnings",
		"build": "turbo run compile && cargo build --release --manifest-path backend/Cargo.toml",
		"db:generate": "prisma generate",
		"db:migrate": "prisma migrate deploy"
	},
	"devDependencies": {
		"bun-types": "1.3.11",
		"prettier": "3.8.1",
		"turbo": "2.9.4",
		"typescript": "5.9.3"
	},
	"dependencies": {
		"dotenv": "^17.4.2",
		"kysely": "^0.28.16",
		"kysely-postgres-js": "^3.0.0",
		"postgres": "^3.4.9",
		"prettier-plugin-svelte": "^3.5.1",
		"prettier-plugin-tailwindcss": "^0.7.4",
		"prisma": "^7.8.0",
		"prisma-kysely": "^3.1.0",
		"superjson": "^2.2.6",
		"zod": "^4.4.2",
		"zod-validation-error": "^5.0.0"
	}
}
